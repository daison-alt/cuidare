.financeiro-page {
  min-height: 100vh;
  padding: 34px;
  background: #f7f9fc;
  color: #1f2937;
}

.financeiro-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.financeiro-kicker {
  display: block;
  margin-bottom: 8px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.4px;
  color: #6b7280;
}

.financeiro-header h1 {
  margin: 0;
  font-size: 30px;
  font-weight: 700;
}

.financeiro-header p {
  margin: 8px 0 0;
  color: #6b7280;
}

.financeiro-header-actions,
.financeiro-form-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.financeiro-primary-button,
.financeiro-secondary-button,
.financeiro-refresh-button {
  border: 0;
  border-radius: 10px;
  padding: 11px 16px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
}

.financeiro-primary-button {
  background: #1f8f83;
  color: white;
}

.financeiro-primary-button:hover {
  background: #18786e;
}

.financeiro-primary-button:disabled,
.financeiro-secondary-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.financeiro-secondary-button {
  background: white;
  color: #374151;
  border: 1px solid #dce2ea;
}

.financeiro-secondary-button:hover {
  background: #f3f4f6;
}

.financeiro-alert {
  margin-bottom: 20px;
  padding: 14px 16px;
  border-radius: 10px;
  background: #fff1f2;
  color: #be123c;
  border: 1px solid #fecdd3;
}

.financeiro-resumo {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin-bottom: 24px;
}

.financeiro-resumo-card {
  padding: 22px;
  background: white;
  border: 1px solid #e5eaf0;
  border-radius: 14px;
  box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
}

.financeiro-resumo-card span {
  display: block;
  margin-bottom: 9px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #7b8491;
}

.financeiro-resumo-card strong {
  display: block;
  font-size: 25px;
  color: #1f2937;
}

.financeiro-resumo-card small {
  display: block;
  margin-top: 7px;
  color: #8a94a3;
}

.financeiro-form-card,
.financeiro-lista {
  padding: 24px;
  margin-bottom: 24px;
  background: white;
  border: 1px solid #e5eaf0;
  border-radius: 14px;
  box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
}

.financeiro-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.financeiro-section-title span {
  display: block;
  margin-bottom: 5px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #7b8491;
}

.financeiro-section-title h2 {
  margin: 0;
  font-size: 21px;
}

.financeiro-contador {
  white-space: nowrap;
}

.financeiro-form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
}

.financeiro-form-grid label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 13px;
  font-weight: 600;
  color: #374151;
}

.financeiro-form-grid input,
.financeiro-form-grid select,
.financeiro-form-grid textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 13px;
  border: 1px solid #dce2ea;
  border-radius: 9px;
  outline: none;
  font: inherit;
  color: #1f2937;
  background: white;
  transition: 0.2s ease;
}

.financeiro-form-grid input:focus,
.financeiro-form-grid select:focus,
.financeiro-form-grid textarea:focus {
  border-color: #1f8f83;
  box-shadow: 0 0 0 3px rgba(31, 143, 131, 0.1);
}

.financeiro-form-full {
  grid-column: 1 / -1;
}

.financeiro-form-actions {
  justify-content: flex-end;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid #edf0f3;
}

.financeiro-table-wrapper {
  width: 100%;
  overflow-x: auto;
}

.financeiro-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 950px;
}

.financeiro-table th {
  padding: 13px 14px;
  text-align: left;
  font-size: 11px;
  letter-spacing: 0.7px;
  text-transform: uppercase;
  color: #7b8491;
  background: #f8fafb;
  border-bottom: 1px solid #e5eaf0;
}

.financeiro-table td {
  padding: 15px 14px;
  border-bottom: 1px solid #edf0f3;
  font-size: 14px;
  color: #4b5563;
  vertical-align: middle;
}

.financeiro-table tbody tr:hover {
  background: #fafcfc;
}

.financeiro-table td:first-child {
  color: #1f2937;
}

.financeiro-table td small {
  display: block;
  margin-top: 4px;
  max-width: 300px;
  color: #8a94a3;
  font-size: 12px;
}

.financeiro-status {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.financeiro-status-pendente {
  background: #fff7e6;
  color: #a16207;
}

.financeiro-status-pago {
  background: #eaf8f2;
  color: #15803d;
}

.financeiro-status-vencido {
  background: #fff1f2;
  color: #be123c;
}

.financeiro-status-cancelado {
  background: #f1f3f5;
  color: #6b7280;
}

.financeiro-acoes {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.financeiro-acao {
  border: 1px solid #dce2ea;
  background: white;
  border-radius: 7px;
  padding: 7px 9px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s ease;
  white-space: nowrap;
}

.financeiro-acao.receber {
  border-color: #b9ddd7;
  background: #eef8f6;
  color: #18786e;
}

.financeiro-acao.receber:hover {
  background: #dff2ee;
}

.financeiro-acao.editar {
  color: #374151;
}

.financeiro-acao.editar:hover {
  background: #f3f4f6;
}

.financeiro-acao.excluir {
  border-color: #f1c5cc;
  color: #be123c;
}

.financeiro-acao.excluir:hover {
  background: #fff1f2;
}

.financeiro-empty {
  min-height: 190px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #6b7280;
}

.financeiro-empty-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  border-radius: 50%;
  background: #eef4f3;
  color: #1f8f83;
  font-size: 22px;
  font-weight: 700;
}

.financeiro-empty strong {
  color: #374151;
}

.financeiro-empty p {
  margin: 7px 0 0;
}

/* MODAL */

.financeiro-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(3px);
}

.financeiro-modal {
  width: min(720px, 100%);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  padding: 26px;
  background: white;
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(15, 23, 42, 0.2);
}

.financeiro-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.financeiro-modal-header span {
  display: block;
  margin-bottom: 6px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #7b8491;
}

.financeiro-modal-header h2 {
  margin: 0;
  font-size: 23px;
  color: #1f2937;
}

.financeiro-modal-header p {
  margin: 6px 0 0;
  color: #6b7280;
  font-size: 14px;
}

.financeiro-modal-close {
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border: 0;
  border-radius: 8px;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
}

.financeiro-modal-close:hover {
  background: #e5e7eb;
}

.financeiro-modal-close:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.financeiro-recebimento-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
  padding: 16px 18px;
  border-radius: 10px;
  background: #f4f8f7;
  border: 1px solid #dcece9;
}

.financeiro-recebimento-info span {
  font-size: 13px;
  color: #6b7280;
}

.financeiro-recebimento-info strong {
  font-size: 20px;
  color: #1f8f83;
}

@media (max-width: 1100px) {
  .financeiro-table {
    min-width: 850px;
  }
}

@media (max-width: 900px) {
  .financeiro-page {
    padding: 24px;
  }

  .financeiro-resumo {
    grid-template-columns: 1fr;
  }

  .financeiro-header {
    flex-direction: column;
  }

  .financeiro-header-actions {
    width: 100%;
  }
}

@media (max-width: 650px) {
  .financeiro-page {
    padding: 18px;
  }

  .financeiro-form-grid {
    grid-template-columns: 1fr;
  }

  .financeiro-form-full {
    grid-column: auto;
  }

  .financeiro-header-actions {
    width: 100%;
  }

  .financeiro-header-actions button {
    flex: 1;
  }

  .financeiro-modal-overlay {
    padding: 12px;
  }

  .financeiro-modal {
    padding: 20px;
    max-height: calc(100vh - 24px);
  }

  .financeiro-recebimento-info {
    align-items: flex-start;
    flex-direction: column;
    gap: 5px;
  }
}
