/* =========================================================
   BOTÃO GLOBAL DE TEMA
   ========================================================= */

#cuidare-theme-toggle {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 99999;

  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #dfe7e4;
  border-radius: 50%;

  background: #ffffff;
  color: #173b36;

  font-size: 21px;
  line-height: 1;

  cursor: pointer;

  box-shadow:
    0 8px 22px rgba(23, 59, 54, 0.15);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

#cuidare-theme-toggle:hover {
  transform: translateY(-2px);
  box-shadow:
    0 12px 28px rgba(23, 59, 54, 0.22);
}

#cuidare-theme-toggle:active {
  transform: scale(0.95);
}

