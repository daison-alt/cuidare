.pacientes-page {
  padding: 30px 34px 40px;
}

.pacientes-header {
  margin-bottom: 24px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.pacientes-header h2 {
  margin: 6px 0 8px;
  color: #2b2b2b;
  font-size: 26px;
}

.pacientes-header p {
  margin: 0;
  color: #666666;
  font-size: 13px;
  line-height: 1.6;
}

.pacientes-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pacientes-back-button,
.pacientes-new-button {
  padding: 10px 15px;
  border-radius: 9px;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.pacientes-back-button {
  border: 1px solid #dcdcd6;
  background: #ffffff;
  color: #555555;
}

.pacientes-back-button:hover {
  border-color: #c29b47;
  color: #0e4334;
}

.pacientes-new-button {
  border: 0;
  background: #0e4334;
  color: #ffffff;
}

.pacientes-new-button:hover {
  background: #145a45;
  transform: translateY(-1px);
}

.pacientes-alert {
  margin-bottom: 20px;
  padding: 13px 16px;
  border: 1px solid #e6caca;
  border-radius: 10px;
  background: #fff4f4;
  color: #9b3d3d;
  font-size: 13px;
}

.pacientes-panel {
  border: 1px solid #e4e4df;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 3px 14px rgba(14, 67, 52, 0.04);
  overflow: hidden;
}

.pacientes-toolbar {
  padding: 22px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid #e7e7e2;
}

.toolbar-label {
  color: #c29b47;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.2px;
}

.pacientes-toolbar h3 {
  margin: 5px 0 0;
  color: #2b2b2b;
  font-size: 18px;
}

.pacientes-search {
  width: min(380px, 100%);
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 12px;
  border: 1px solid #dcdcd6;
  border-radius: 9px;
  background: #ffffff;
}

.pacientes-search span {
  color: #858585;
  font-size: 20px;
}

.pacientes-search input {
  width: 100%;
  border: 0;
  outline: none;
  color: #2b2b2b;
  font: inherit;
  font-size: 13px;
}

.pacientes-search input::placeholder {
  color: #999999;
}

.pacientes-list-header,
.paciente-row {
  display: grid;
  grid-template-columns: 2fr 1.5fr 1fr 0.8fr 1.2fr;
  gap: 20px;
  align-items: center;
}

.pacientes-list-header {
  padding: 12px 24px;
  background: #fafaf8;
  border-bottom: 1px solid #e7e7e2;
  color: #858585;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.7px;
  text-transform: uppercase;
}

.paciente-row {
  padding: 16px 24px;
  border-bottom: 1px solid #eeeeea;
  transition: background 0.2s ease;
}

.paciente-row:last-child {
  border-bottom: 0;
}

.paciente-row:hover {
  background: #fcfcfa;
}

.paciente-info {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}

.paciente-avatar {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3ebd8;
  color: #0e4334;
  font-size: 14px;
  font-weight: 700;
}

.paciente-info div:last-child,
.paciente-contact {
  min-width: 0;
}

.paciente-info strong,
.paciente-info span,
.paciente-contact strong,
.paciente-contact span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.paciente-info strong,
.paciente-contact strong {
  color: #2b2b2b;
  font-size: 13px;
}

.paciente-info span,
.paciente-contact span,
.paciente-birth {
  margin-top: 4px;
  color: #858585;
  font-size: 11px;
}

.paciente-status {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 20px;
  background: #e6f4e4;
  color: #39743b;
  font-size: 10px;
  font-weight: 700;
}

.paciente-actions {
  display: flex;
  gap: 6px;
}

.paciente-actions button {
  padding: 7px 9px;
  border: 1px solid #deded8;
  border-radius: 7px;
  background: #ffffff;
  color: #555555;
  font-size: 10px;
  font-weight: 600;
}

.paciente-actions button:hover {
  border-color: #c29b47;
  color: #0e4334;
}

.pacientes-empty {
  min-height: 300px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #858585;
}

.pacientes-empty strong {
  color: #2b2b2b;
  font-size: 14px;
}

.pacientes-empty p {
  margin: 6px 0 0;
  font-size: 12px;
}

.empty-icon {
  width: 42px;
  height: 42px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f3ebd8;
  color: #c29b47;
  font-size: 22px;
}

@media (max-width: 1000px) {
  .pacientes-list-header {
    display: none;
  }

  .paciente-row {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .paciente-actions {
    justify-content: flex-start;
  }
}

@media (max-width: 700px) {
  .pacientes-page {
    padding: 22px 18px 30px;
  }

  .pacientes-header {
    align-items: stretch;
    flex-direction: column;
  }

  .pacientes-header-actions {
    justify-content: flex-start;
  }

  .pacientes-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .pacientes-search {
    width: 100%;
  }

  .paciente-row {
    grid-template-columns: 1fr;
  }
}
