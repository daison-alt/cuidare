import { useEffect, useMemo, useState } from "react";
import "./Caixa.css";

const API_URL =
  window.location.hostname.includes("app.github.dev")
    ? `https://${window.location.hostname.replace(
        "-5173.app.github.dev",
        "-8000.app.github.dev"
      )}`
    : "http://localhost:8000";

const TIPOS = {
  entrada: "Entrada",
  saida: "Saída",
  sangria: "Sangria",
  suprimento: "Suprimento",
};

const FORMAS_PAGAMENTO = {
  dinheiro: "Dinheiro",
  pix: "Pix",
  cartao_credito: "Cartão de crédito",
  cartao_debito: "Cartão de débito",
  transferencia: "Transferência",
  outro: "Outro",
};

const FORMAS_CONFERENCIA = [
  {
    chave: "dinheiro",
    nome: "Dinheiro em espécie",
    esperado: "dinheiro_esperado",
    informado: "dinheiro_informado",
    diferenca: "diferenca_dinheiro",
  },
  {
    chave: "pix",
    nome: "Pix",
    esperado: "pix_esperado",
    informado: "pix_informado",
  },
  {
    chave: "cartao_credito",
    nome: "Cartão de crédito",
    esperado: "cartao_credito_esperado",
    informado: "cartao_credito_informado",
  },
  {
    chave: "cartao_debito",
    nome: "Cartão de débito",
    esperado: "cartao_debito_esperado",
    informado: "cartao_debito_informado",
  },
  {
    chave: "transferencia",
    nome: "Transferência bancária",
    esperado: "transferencia_esperada",
    informado: "transferencia_informada",
  },
];

function formatarMoeda(valor) {
  return Number(valor || 0).toLocaleString("pt-BR", {
    style: "currency",
    currency: "BRL",
  });
}

function formatarData(data) {
  if (!data) return "-";

  return new Date(data).toLocaleString("pt-BR", {
    dateStyle: "short",
    timeStyle: "short",
  });
}

function classeDiferenca(valor) {
  const numero = Number(valor || 0);

  if (numero === 0) return "caixa-conferencia-ok";
  if (numero > 0) return "caixa-conferencia-sobra";

  return "caixa-conferencia-falta";
}

function textoDiferenca(valor) {
  const numero = Number(valor || 0);

  if (numero === 0) return "Conferido";
  if (numero > 0) return "Sobra";
  return "Falta";
}

function Caixa({ onVoltar }) {
  const [caixa, setCaixa] = useState(null);
  const [saldo, setSaldo] = useState(null);
  const [movimentacoes, setMovimentacoes] = useState([]);
  const [conferencia, setConferencia] = useState(null);

  const [carregando, setCarregando] = useState(true);
  const [carregandoConferencia, setCarregandoConferencia] =
    useState(false);

  const [erro, setErro] = useState("");
  const [sucesso, setSucesso] = useState("");

  const [mostrarAbertura, setMostrarAbertura] = useState(false);
  const [mostrarMovimentacao, setMostrarMovimentacao] =
    useState(false);
  const [mostrarFechamento, setMostrarFechamento] =
    useState(false);
  const [mostrarConferencia, setMostrarConferencia] =
    useState(false);

  const [saldoInicial, setSaldoInicial] = useState("");
  const [saldoFinal, setSaldoFinal] = useState("");
  const [observacoes, setObservacoes] = useState("");

  const [valoresConferencia, setValoresConferencia] =
    useState({
      dinheiro_informado: "",
      pix_informado: "",
      cartao_credito_informado: "",
      cartao_debito_informado: "",
      transferencia_informada: "",
      observacoes: "",
      conferido_por: "",
    });

  const [movimentacao, setMovimentacao] = useState({
    tipo: "entrada",
    categoria: "",
    descricao: "",
    valor: "",
    forma_pagamento: "",
    observacoes: "",
  });

  async function carregarConferencia() {
    try {
      setCarregandoConferencia(true);

      const resposta = await fetch(
        `${API_URL}/caixa/conferencia`
      );

      if (resposta.status === 404) {
        setConferencia(null);
        return;
      }

      if (!resposta.ok) {
        throw new Error(
          "Não foi possível carregar a conferência do caixa."
        );
      }

      const dados = await resposta.json();

      setConferencia(dados);

      if (dados.ultima_conferencia) {
        setValoresConferencia((atual) => ({
          ...atual,
          dinheiro_informado:
            dados.ultima_conferencia.dinheiro_informado ?? "",
          pix_informado:
            dados.ultima_conferencia.pix_informado ?? "",
          cartao_credito_informado:
            dados.ultima_conferencia
              .cartao_credito_informado ?? "",
          cartao_debito_informado:
            dados.ultima_conferencia
              .cartao_debito_informado ?? "",
          transferencia_informada:
            dados.ultima_conferencia
              .transferencia_informada ?? "",
          observacoes:
            dados.ultima_conferencia.observacoes ?? "",
          conferido_por:
            dados.ultima_conferencia.conferido_por ?? "",
        }));
      }
    } catch (error) {
      console.error(error);
      setErro(
        error.message ||
          "Erro ao carregar a conferência do caixa."
      );
    } finally {
      setCarregandoConferencia(false);
    }
  }

  async function carregarCaixa() {
    try {
      setCarregando(true);
      setErro("");

      const respostaCaixa = await fetch(`${API_URL}/caixa/aberto`);

      if (respostaCaixa.status === 404) {
        setCaixa(null);
        setSaldo(null);
        setMovimentacoes([]);
        setConferencia(null);
        return;
      }

      if (!respostaCaixa.ok) {
        throw new Error("Não foi possível consultar o caixa.");
      }

      const dadosCaixa = await respostaCaixa.json();

      const [
        respostaSaldo,
        respostaMovimentacoes,
        respostaConferencia,
      ] = await Promise.all([
        fetch(`${API_URL}/caixa/saldo`),
        fetch(`${API_URL}/caixa/movimentacoes`),
        fetch(`${API_URL}/caixa/conferencia`),
      ]);

      if (
        !respostaSaldo.ok ||
        !respostaMovimentacoes.ok
      ) {
        throw new Error(
          "Não foi possível carregar os dados do caixa."
        );
      }

      const dadosSaldo = await respostaSaldo.json();
      const dadosMovimentacoes =
        await respostaMovimentacoes.json();

      let dadosConferencia = null;

      if (respostaConferencia.ok) {
        dadosConferencia = await respostaConferencia.json();
      }

      setCaixa(dadosCaixa);
      setSaldo(dadosSaldo);

      setMovimentacoes(
        Array.isArray(dadosMovimentacoes)
          ? dadosMovimentacoes
          : []
      );

      setConferencia(dadosConferencia);
    } catch (error) {
      console.error(error);
      setErro(error.message || "Erro ao carregar o caixa.");
    } finally {
      setCarregando(false);
    }
  }

  useEffect(() => {
    carregarCaixa();
  }, []);

  function alterarMovimentacao(event) {
    const { name, value } = event.target;

    setMovimentacao((atual) => ({
      ...atual,
      [name]: value,
    }));
  }

  function alterarConferencia(event) {
    const { name, value } = event.target;

    setValoresConferencia((atual) => ({
      ...atual,
      [name]: value,
    }));
  }

  async function abrirCaixa(event) {
    event.preventDefault();

    if (!saldoInicial) {
      setErro("Informe o saldo inicial do caixa.");
      return;
    }

    try {
      setErro("");

      const resposta = await fetch(`${API_URL}/caixa/abrir`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          saldo_inicial: Number(saldoInicial),
          observacoes: observacoes.trim() || null,
        }),
      });

      const dados = await resposta.json();

      if (!resposta.ok) {
        throw new Error(
          dados.detail || "Não foi possível abrir o caixa."
        );
      }

      setSaldoInicial("");
      setObservacoes("");
      setMostrarAbertura(false);
      setSucesso("Caixa aberto com sucesso.");

      await carregarCaixa();
    } catch (error) {
      console.error(error);
      setErro(error.message || "Erro ao abrir o caixa.");
    }
  }

  async function registrarMovimentacao(event) {
    event.preventDefault();

    if (
      !movimentacao.categoria.trim() ||
      !movimentacao.descricao.trim() ||
      !movimentacao.valor
    ) {
      setErro(
        "Preencha categoria, descrição e valor da movimentação."
      );
      return;
    }

    try {
      setErro("");

      const resposta = await fetch(
        `${API_URL}/caixa/movimentacoes`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            ...movimentacao,
            categoria: movimentacao.categoria.trim(),
            descricao: movimentacao.descricao.trim(),
            valor: Number(movimentacao.valor),
            forma_pagamento:
              movimentacao.forma_pagamento || null,
            observacoes:
              movimentacao.observacoes.trim() || null,
          }),
        }
      );

      const dados = await resposta.json();

      if (!resposta.ok) {
        throw new Error(
          dados.detail ||
            "Não foi possível registrar a movimentação."
        );
      }

      setMovimentacao({
        tipo: "entrada",
        categoria: "",
        descricao: "",
        valor: "",
        forma_pagamento: "",
        observacoes: "",
      });

      setMostrarMovimentacao(false);
      setSucesso("Movimentação registrada com sucesso.");

      await carregarCaixa();
    } catch (error) {
      console.error(error);
      setErro(
        error.message || "Erro ao registrar movimentação."
      );
    }
  }

  async function registrarConferencia(event) {
    event.preventDefault();

    try {
      setErro("");
      setSucesso("");

      const resposta = await fetch(
        `${API_URL}/caixa/conferencia`,
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            dinheiro_informado: Number(
              valoresConferencia.dinheiro_informado || 0
            ),
            pix_informado: Number(
              valoresConferencia.pix_informado || 0
            ),
            cartao_credito_informado: Number(
              valoresConferencia.cartao_credito_informado || 0
            ),
            cartao_debito_informado: Number(
              valoresConferencia.cartao_debito_informado || 0
            ),
            transferencia_informada: Number(
              valoresConferencia.transferencia_informada || 0
            ),
            observacoes:
              valoresConferencia.observacoes.trim() || null,
            conferido_por:
              valoresConferencia.conferido_por.trim() || null,
          }),
        }
      );

      const dados = await resposta.json();

      if (!resposta.ok) {
        throw new Error(
          dados.detail ||
            "Não foi possível registrar a conferência."
        );
      }

      setConferencia((atual) => ({
        ...(atual || {}),
        dinheiro_esperado: dados.dinheiro_esperado,
        pix_esperado: dados.pix_esperado,
        cartao_credito_esperado:
          dados.cartao_credito_esperado,
        cartao_debito_esperado:
          dados.cartao_debito_esperado,
        transferencia_esperada:
          dados.transferencia_esperada,
        total_esperado: dados.total_esperado,
        total_eletronico_esperado:
          Number(dados.pix_esperado || 0) +
          Number(dados.cartao_credito_esperado || 0) +
          Number(dados.cartao_debito_esperado || 0) +
          Number(dados.transferencia_esperada || 0),
        ultima_conferencia: dados,
      }));

      setMostrarConferencia(false);
      setSucesso(
        "Conferência registrada com sucesso."
      );

      await carregarConferencia();
    } catch (error) {
      console.error(error);
      setErro(
        error.message ||
          "Erro ao registrar a conferência."
      );
    }
  }

  async function fecharCaixa(event) {
    event.preventDefault();

    if (!saldoFinal) {
      setErro("Informe o saldo final do caixa.");
      return;
    }

    try {
      setErro("");

      const resposta = await fetch(`${API_URL}/caixa/fechar`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          saldo_final: Number(saldoFinal),
          observacoes: observacoes.trim() || null,
        }),
      });

      const dados = await resposta.json();

      if (!resposta.ok) {
        throw new Error(
          dados.detail || "Não foi possível fechar o caixa."
        );
      }

      setSaldoFinal("");
      setObservacoes("");
      setMostrarFechamento(false);

      setCaixa(null);
      setSaldo(null);
      setMovimentacoes([]);
      setConferencia(null);

      setSucesso("Caixa fechado com sucesso.");
    } catch (error) {
      console.error(error);
      setErro(error.message || "Erro ao fechar o caixa.");
    }
  }

  const totais = useMemo(() => {
    return movimentacoes.reduce(
      (resultado, item) => {
        const valor = Number(item.valor || 0);

        if (
          item.tipo === "entrada" ||
          item.tipo === "suprimento"
        ) {
          resultado.entradas += valor;
        }

        if (
          item.tipo === "saida" ||
          item.tipo === "sangria"
        ) {
          resultado.saidas += valor;
        }

        if (item.tipo === "sangria") {
          resultado.sangrias += valor;
        }

        if (item.tipo === "suprimento") {
          resultado.suprimentos += valor;
        }

        return resultado;
      },
      {
        entradas: 0,
        saidas: 0,
        sangrias: 0,
        suprimentos: 0,
      }
    );
  }, [movimentacoes]);

  const resumoFormasPagamento = useMemo(() => {
    const resultado = {
      dinheiro: 0,
      pix: 0,
      cartao_credito: 0,
      cartao_debito: 0,
      transferencia: 0,
    };

    movimentacoes.forEach((item) => {
      if (!resultado.hasOwnProperty(item.forma_pagamento)) {
        return;
      }

      const valor = Number(item.valor || 0);

      if (
        item.tipo === "entrada" ||
        item.tipo === "suprimento"
      ) {
        resultado[item.forma_pagamento] += valor;
      }

      if (
        item.tipo === "saida" ||
        item.tipo === "sangria"
      ) {
        resultado[item.forma_pagamento] -= valor;
      }
    });

    return resultado;
  }, [movimentacoes]);

  const dinheiroEsperado =
    Number(
      conferencia?.dinheiro_esperado ??
        resumoFormasPagamento.dinheiro +
          Number(caixa?.saldo_inicial || 0)
    );

  const totalEletronicoEsperado =
    Number(
      conferencia?.total_eletronico_esperado ??
        resumoFormasPagamento.pix +
          resumoFormasPagamento.cartao_credito +
          resumoFormasPagamento.cartao_debito +
          resumoFormasPagamento.transferencia
    );

  const totalFinanceiroEsperado =
    dinheiroEsperado + totalEletronicoEsperado;

  const possuiConferencia =
    Boolean(conferencia?.ultima_conferencia);

  return (
    <div className="caixa-page">
      <header className="caixa-header">
        <div>
          <span className="caixa-kicker">CAIXA</span>

          <h1>Controle de Caixa</h1>

          <p>
            Acompanhe abertura, movimentações, formas de
            pagamento e conferência do caixa.
          </p>
        </div>

        <div className="caixa-header-actions">
          <button
            type="button"
            className="caixa-secondary-button"
            onClick={onVoltar}
          >
            Voltar
          </button>

          <button
            type="button"
            className="caixa-refresh-button"
            onClick={carregarCaixa}
          >
            Atualizar
          </button>

          {caixa && (
            <button
              type="button"
              className="caixa-danger-button"
              onClick={() => {
                setErro("");
                setSucesso("");
                setMostrarFechamento(true);
              }}
            >
              Fechar caixa
            </button>
          )}
        </div>
      </header>

      {erro && (
        <div className="caixa-alert caixa-alert-erro">
          {erro}
        </div>
      )}

      {sucesso && (
        <div className="caixa-alert caixa-alert-sucesso">
          {sucesso}
        </div>
      )}

      {carregando ? (
        <section className="caixa-empty">
          <strong>Carregando caixa...</strong>
          <p>Aguarde enquanto consultamos os dados.</p>
        </section>
      ) : !caixa ? (
        <section className="caixa-card caixa-card-abertura">
          <span className="caixa-kicker">CAIXA FECHADO</span>

          <h2>Nenhum caixa está aberto</h2>

          <p>
            Abra o caixa para começar a registrar
            recebimentos, pagamentos, sangrias e suprimentos.
          </p>

          {!mostrarAbertura ? (
            <button
              type="button"
              className="caixa-primary-button"
              onClick={() => {
                setErro("");
                setSucesso("");
                setMostrarAbertura(true);
              }}
            >
              Abrir caixa
            </button>
          ) : (
            <form onSubmit={abrirCaixa} className="caixa-form">
              <label>
                Saldo inicial
                <input
                  type="number"
                  step="0.01"
                  min="0"
                  value={saldoInicial}
                  onChange={(event) =>
                    setSaldoInicial(event.target.value)
                  }
                  placeholder="0,00"
                />
              </label>

              <label>
                Observações
                <textarea
                  rows="3"
                  value={observacoes}
                  onChange={(event) =>
                    setObservacoes(event.target.value)
                  }
                  placeholder="Observações da abertura..."
                />
              </label>

              <div className="caixa-form-actions">
                <button
                  type="button"
                  className="caixa-secondary-button"
                  onClick={() => setMostrarAbertura(false)}
                >
                  Cancelar
                </button>

                <button
                  type="submit"
                  className="caixa-primary-button"
                >
                  Confirmar abertura
                </button>
              </div>
            </form>
          )}
        </section>
      ) : (
        <>
          <section className="caixa-status-card">
            <div>
              <span>STATUS</span>
              <strong>Caixa aberto</strong>
              <small>
                Aberto em {formatarData(caixa.data_abertura)}
              </small>
            </div>

            <div className="caixa-status-saldo">
              <span>SALDO FINANCEIRO ATUAL</span>
              <strong>
                {formatarMoeda(saldo?.saldo_atual)}
              </strong>
              <small>
                Inclui dinheiro e valores eletrônicos
              </small>
            </div>
          </section>

          <section className="caixa-resumo-grid">
            <div className="caixa-resumo-card">
              <span>ENTRADAS</span>
              <strong>
                {formatarMoeda(totais.entradas)}
              </strong>
            </div>

            <div className="caixa-resumo-card">
              <span>SAÍDAS</span>
              <strong>
                {formatarMoeda(totais.saidas)}
              </strong>
            </div>

            <div className="caixa-resumo-card">
              <span>SANGRIAS</span>
              <strong>
                {formatarMoeda(totais.sangrias)}
              </strong>
            </div>

            <div className="caixa-resumo-card">
              <span>SUPRIMENTOS</span>
              <strong>
                {formatarMoeda(totais.suprimentos)}
              </strong>
            </div>
          </section>

          <section className="caixa-card caixa-formas-card">
            <div className="caixa-section-header">
              <div>
                <span className="caixa-kicker">
                  CONTROLE FINANCEIRO
                </span>

                <h2>Dinheiro em espécie e valores eletrônicos</h2>

                <p className="caixa-section-description">
                  O sistema separa automaticamente o dinheiro
                  físico dos pagamentos eletrônicos.
                </p>
              </div>
            </div>

            <div className="caixa-formas-grid">
              <div className="caixa-forma-card caixa-forma-especie">
                <span>DINHEIRO EM ESPÉCIE</span>

                <strong>
                  {formatarMoeda(dinheiroEsperado)}
                </strong>

                <small>
                  Valor esperado na gaveta/cofre
                </small>
              </div>

              <div className="caixa-forma-card">
                <span>PIX</span>

                <strong>
                  {formatarMoeda(
                    resumoFormasPagamento.pix
                  )}
                </strong>

                <small>
                  Conferência pelo extrato do Pix
                </small>
              </div>

              <div className="caixa-forma-card">
                <span>CARTÃO DE CRÉDITO</span>

                <strong>
                  {formatarMoeda(
                    resumoFormasPagamento.cartao_credito
                  )}
                </strong>

                <small>
                  Conferência pela maquininha
                </small>
              </div>

              <div className="caixa-forma-card">
                <span>CARTÃO DE DÉBITO</span>

                <strong>
                  {formatarMoeda(
                    resumoFormasPagamento.cartao_debito
                  )}
                </strong>

                <small>
                  Conferência pela maquininha
                </small>
              </div>

              <div className="caixa-forma-card">
                <span>TRANSFERÊNCIA</span>

                <strong>
                  {formatarMoeda(
                    resumoFormasPagamento.transferencia
                  )}
                </strong>

                <small>
                  Conferência pelo banco
                </small>
              </div>
            </div>

            <div className="caixa-total-separado">
              <div>
                <span>TOTAL EM ESPÉCIE</span>
                <strong>
                  {formatarMoeda(dinheiroEsperado)}
                </strong>
              </div>

              <div>
                <span>TOTAL ELETRÔNICO</span>
                <strong>
                  {formatarMoeda(totalEletronicoEsperado)}
                </strong>
              </div>

              <div>
                <span>TOTAL FINANCEIRO</span>
                <strong>
                  {formatarMoeda(totalFinanceiroEsperado)}
                </strong>
              </div>
            </div>
          </section>

          <section className="caixa-card caixa-conferencia-card">
            <div className="caixa-section-header">
              <div>
                <span className="caixa-kicker">
                  CONFERÊNCIA
                </span>

                <h2>Conferência de caixa</h2>

                <p className="caixa-section-description">
                  Informe quanto foi realmente encontrado em
                  espécie e quanto consta em cada meio eletrônico.
                </p>
              </div>

              <button
                type="button"
                className="caixa-primary-button"
                onClick={() => {
                  setErro("");
                  setSucesso("");
                  setMostrarConferencia(
                    !mostrarConferencia
                  );
                }}
              >
                {possuiConferencia
                  ? "Nova conferência"
                  : "Conferir caixa"}
              </button>
            </div>

            {mostrarConferencia && (
              <form
                onSubmit={registrarConferencia}
                className="caixa-conferencia-form"
              >
                <div className="caixa-conferencia-intro">
                  <strong>
                    Informe os valores efetivamente
                    conferidos:
                  </strong>

                  <span>
                    Dinheiro físico deve ser contado na gaveta.
                    Pix, cartões e transferências devem ser
                    conferidos nos respectivos extratos.
                  </span>
                </div>

                <div className="caixa-conferencia-grid">
                  {FORMAS_CONFERENCIA.map((forma) => (
                    <label
                      key={forma.chave}
                      className="caixa-conferencia-input"
                    >
                      <span>{forma.nome}</span>

                      <input
                        type="number"
                        step="0.01"
                        min="0"
                        name={forma.informado}
                        value={
                          valoresConferencia[
                            forma.informado
                          ]
                        }
                        onChange={alterarConferencia}
                        placeholder="0,00"
                      />

                      <small>
                        Esperado:{" "}
                        {formatarMoeda(
                          conferencia?.[forma.esperado]
                        )}
                      </small>
                    </label>
                  ))}
                </div>

                <label className="caixa-form-full">
                  Conferido por
                  <input
                    name="conferido_por"
                    value={valoresConferencia.conferido_por}
                    onChange={alterarConferencia}
                    placeholder="Nome do responsável pela conferência"
                  />
                </label>

                <label className="caixa-form-full">
                  Observações
                  <textarea
                    name="observacoes"
                    rows="3"
                    value={valoresConferencia.observacoes}
                    onChange={alterarConferencia}
                    placeholder="Informe alguma diferença, ocorrência ou observação..."
                  />
                </label>

                <div className="caixa-form-actions">
                  <button
                    type="button"
                    className="caixa-secondary-button"
                    onClick={() =>
                      setMostrarConferencia(false)
                    }
                  >
                    Cancelar
                  </button>

                  <button
                    type="submit"
                    className="caixa-primary-button"
                  >
                    Registrar conferência
                  </button>
                </div>
              </form>
            )}

            {carregandoConferencia ? (
              <div className="caixa-conferencia-carregando">
                Carregando última conferência...
              </div>
            ) : conferencia?.ultima_conferencia ? (
              <div className="caixa-conferencia-resultado">
                <div className="caixa-conferencia-result-header">
                  <div>
                    <span>ÚLTIMA CONFERÊNCIA</span>

                    <strong>
                      {formatarData(
                        conferencia.ultima_conferencia
                          .data_conferencia
                      )}
                    </strong>
                  </div>

                  <div
                    className={`caixa-conferencia-status ${classeDiferenca(
                      conferencia.ultima_conferencia
                        .diferenca_total
                    )}`}
                  >
                    {textoDiferenca(
                      conferencia.ultima_conferencia
                        .diferenca_total
                    )}
                  </div>
                </div>

                <div className="caixa-conferencia-table-wrapper">
                  <table className="caixa-conferencia-table">
                    <thead>
                      <tr>
                        <th>Forma de pagamento</th>
                        <th>Esperado</th>
                        <th>Conferido</th>
                        <th>Diferença</th>
                        <th>Status</th>
                      </tr>
                    </thead>

                    <tbody>
                      {FORMAS_CONFERENCIA.map((forma) => {
                        const esperado = Number(
                          conferencia.ultima_conferencia[
                            forma.esperado
                          ] || 0
                        );

                        const informado = Number(
                          conferencia.ultima_conferencia[
                            forma.informado
                          ] || 0
                        );

                        const diferenca =
                          informado - esperado;

                        return (
                          <tr key={forma.chave}>
                            <td>
                              <strong>
                                {forma.nome}
                              </strong>
                            </td>

                            <td>
                              {formatarMoeda(esperado)}
                            </td>

                            <td>
                              {formatarMoeda(informado)}
                            </td>

                            <td
                              className={classeDiferenca(
                                diferenca
                              )}
                            >
                              {formatarMoeda(diferenca)}
                            </td>

                            <td>
                              <span
                                className={`caixa-conferencia-status-mini ${classeDiferenca(
                                  diferenca
                                )}`}
                              >
                                {textoDiferenca(diferenca)}
                              </span>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>

                    <tfoot>
                      <tr>
                        <td>
                          <strong>
                            TOTAL FINANCEIRO
                          </strong>
                        </td>

                        <td>
                          <strong>
                            {formatarMoeda(
                              conferencia.ultima_conferencia
                                .total_esperado
                            )}
                          </strong>
                        </td>

                        <td>
                          <strong>
                            {formatarMoeda(
                              conferencia.ultima_conferencia
                                .total_informado
                            )}
                          </strong>
                        </td>

                        <td
                          className={classeDiferenca(
                            conferencia.ultima_conferencia
                              .diferenca_total
                          )}
                        >
                          <strong>
                            {formatarMoeda(
                              conferencia.ultima_conferencia
                                .diferenca_total
                            )}
                          </strong>
                        </td>

                        <td>
                          <span
                            className={`caixa-conferencia-status-mini ${classeDiferenca(
                              conferencia.ultima_conferencia
                                .diferenca_total
                            )}`}
                          >
                            {textoDiferenca(
                              conferencia.ultima_conferencia
                                .diferenca_total
                            )}
                          </span>
                        </td>
                      </tr>
                    </tfoot>
                  </table>
                </div>

                <div className="caixa-conferencia-resumos">
                  <div>
                    <span>DINHEIRO FÍSICO</span>
                    <strong>
                      {formatarMoeda(
                        conferencia.ultima_conferencia
                          .dinheiro_informado
                      )}
                    </strong>
                    <small>
                      Esperado:{" "}
                      {formatarMoeda(
                        conferencia.ultima_conferencia
                          .dinheiro_esperado
                      )}
                    </small>
                  </div>

                  <div>
                    <span>VALORES ELETRÔNICOS</span>
                    <strong>
                      {formatarMoeda(
                        Number(
                          conferencia.ultima_conferencia
                            .pix_informado || 0
                        ) +
                          Number(
                            conferencia.ultima_conferencia
                              .cartao_credito_informado ||
                              0
                          ) +
                          Number(
                            conferencia.ultima_conferencia
                              .cartao_debito_informado ||
                              0
                          ) +
                          Number(
                            conferencia.ultima_conferencia
                              .transferencia_informada ||
                              0
                          )
                      )}
                    </strong>
                    <small>
                      Não compõem o dinheiro físico
                    </small>
                  </div>
                </div>

                {conferencia.ultima_conferencia
                  .observacoes && (
                  <div className="caixa-conferencia-observacao">
                    <strong>Observações:</strong>{" "}
                    {
                      conferencia.ultima_conferencia
                        .observacoes
                    }
                  </div>
                )}
              </div>
            ) : (
              <div className="caixa-empty caixa-empty-conferencia">
                <strong>
                  Caixa ainda não conferido
                </strong>

                <p>
                  Faça a conferência para comparar o
                  dinheiro físico e os valores eletrônicos.
                </p>
              </div>
            )}
          </section>

          <section className="caixa-card">
            <div className="caixa-section-header">
              <div>
                <span className="caixa-kicker">
                  MOVIMENTAÇÕES
                </span>

                <h2>Movimentações do caixa</h2>
              </div>

              <button
                type="button"
                className="caixa-primary-button"
                onClick={() => {
                  setErro("");
                  setSucesso("");
                  setMostrarMovimentacao(
                    !mostrarMovimentacao
                  );
                }}
              >
                + Nova movimentação
              </button>
            </div>

            {mostrarMovimentacao && (
              <form
                onSubmit={registrarMovimentacao}
                className="caixa-form caixa-form-movimentacao"
              >
                <label>
                  Tipo
                  <select
                    name="tipo"
                    value={movimentacao.tipo}
                    onChange={alterarMovimentacao}
                  >
                    {Object.entries(TIPOS).map(
                      ([valor, nome]) => (
                        <option key={valor} value={valor}>
                          {nome}
                        </option>
                      )
                    )}
                  </select>
                </label>

                <label>
                  Categoria
                  <input
                    name="categoria"
                    value={movimentacao.categoria}
                    onChange={alterarMovimentacao}
                    placeholder="Ex.: Recebimento"
                  />
                </label>

                <label>
                  Descrição
                  <input
                    name="descricao"
                    value={movimentacao.descricao}
                    onChange={alterarMovimentacao}
                    placeholder="Descrição da movimentação"
                  />
                </label>

                <label>
                  Valor
                  <input
                    name="valor"
                    type="number"
                    step="0.01"
                    min="0.01"
                    value={movimentacao.valor}
                    onChange={alterarMovimentacao}
                    placeholder="0,00"
                  />
                </label>

                <label>
                  Forma de pagamento
                  <select
                    name="forma_pagamento"
                    value={movimentacao.forma_pagamento}
                    onChange={alterarMovimentacao}
                  >
                    <option value="">
                      Não informado
                    </option>

                    {Object.entries(
                      FORMAS_PAGAMENTO
                    ).map(([valor, nome]) => (
                      <option key={valor} value={valor}>
                        {nome}
                      </option>
                    ))}
                  </select>
                </label>

                <label className="caixa-form-full">
                  Observações
                  <textarea
                    name="observacoes"
                    rows="3"
                    value={movimentacao.observacoes}
                    onChange={alterarMovimentacao}
                    placeholder="Observações..."
                  />
                </label>

                <div className="caixa-form-actions caixa-form-full">
                  <button
                    type="button"
                    className="caixa-secondary-button"
                    onClick={() =>
                      setMostrarMovimentacao(false)
                    }
                  >
                    Cancelar
                  </button>

                  <button
                    type="submit"
                    className="caixa-primary-button"
                  >
                    Registrar movimentação
                  </button>
                </div>
              </form>
            )}

            {movimentacoes.length === 0 ? (
              <div className="caixa-empty">
                <strong>Nenhuma movimentação</strong>
                <p>
                  Ainda não existem movimentações neste caixa.
                </p>
              </div>
            ) : (
              <div className="caixa-table-wrapper">
                <table className="caixa-table">
                  <thead>
                    <tr>
                      <th>Data</th>
                      <th>Tipo</th>
                      <th>Descrição</th>
                      <th>Categoria</th>
                      <th>Forma</th>
                      <th>Valor</th>
                    </tr>
                  </thead>

                  <tbody>
                    {movimentacoes.map((item) => (
                      <tr key={item.id}>
                        <td>
                          {formatarData(
                            item.data_movimentacao
                          )}
                        </td>

                        <td>
                          <span
                            className={`caixa-tipo caixa-tipo-${item.tipo}`}
                          >
                            {TIPOS[item.tipo] || item.tipo}
                          </span>
                        </td>

                        <td>
                          <strong>{item.descricao}</strong>
                        </td>

                        <td>{item.categoria || "-"}</td>

                        <td>
                          {FORMAS_PAGAMENTO[
                            item.forma_pagamento
                          ] ||
                            item.forma_pagamento ||
                            "-"}
                        </td>

                        <td>
                          <strong>
                            {formatarMoeda(item.valor)}
                          </strong>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>

          {mostrarFechamento && (
            <section className="caixa-card caixa-card-fechamento">
              <div className="caixa-section-header">
                <div>
                  <span className="caixa-kicker">
                    FECHAMENTO
                  </span>

                  <h2>Fechar caixa</h2>

                  <p className="caixa-section-description">
                    O valor informado aqui representa o
                    dinheiro físico encontrado na gaveta/cofre.
                    Valores de Pix, cartões e transferências
                    são conferidos separadamente.
                  </p>
                </div>
              </div>

              <form
                onSubmit={fecharCaixa}
                className="caixa-form"
              >
                <div className="caixa-fechamento-resumo">
                  <span>DINHEIRO EM ESPÉCIE ESPERADO</span>

                  <strong>
                    {formatarMoeda(dinheiroEsperado)}
                  </strong>

                  <small>
                    Este é o valor que deve estar fisicamente
                    no caixa.
                  </small>
                </div>

                <div className="caixa-fechamento-resumo">
                  <span>VALORES ELETRÔNICOS</span>

                  <strong>
                    {formatarMoeda(totalEletronicoEsperado)}
                  </strong>

                  <small>
                    Pix + cartões + transferências.
                  </small>
                </div>

                <label>
                  Dinheiro físico encontrado
                  <input
                    type="number"
                    step="0.01"
                    min="0"
                    value={saldoFinal}
                    onChange={(event) =>
                      setSaldoFinal(event.target.value)
                    }
                    placeholder="0,00"
                  />
                </label>

                <label>
                  Observações
                  <textarea
                    rows="3"
                    value={observacoes}
                    onChange={(event) =>
                      setObservacoes(event.target.value)
                    }
                    placeholder="Observações do fechamento..."
                  />
                </label>

                <div className="caixa-form-actions caixa-form-full">
                  <button
                    type="button"
                    className="caixa-secondary-button"
                    onClick={() =>
                      setMostrarFechamento(false)
                    }
                  >
                    Cancelar
                  </button>

                  <button
                    type="submit"
                    className="caixa-danger-button"
                  >
                    Confirmar fechamento
                  </button>
                </div>
              </form>
            </section>
          )}
        </>
      )}
    </div>
  );
}

export default Caixa;
